{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm install --frozen-lockfile && cd frontend && pnpm run build",
  "outputDirectory": "frontend/.next",
  "installCommand": "pnpm install --frozen-lockfile",
  "framework": null,
  "functions": {
    "frontend/app/api/analyze/route.ts": {
      "maxDuration": 60
    },
    "frontend/app/api/coinapi/route.ts": {
      "maxDuration": 30
    }
  },
  "regions": ["iad1"],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        }
      ]
    }
  ]
}