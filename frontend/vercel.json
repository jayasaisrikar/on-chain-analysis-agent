{
  "functions": {
    "app/api/analyze/route.ts": {
      "maxDuration": 60
    }
  },
  "regions": ["iad1"],
  "buildCommand": "next build",
  "installCommand": "pnpm install --frozen-lockfile",
  "env": {
    "NEXT_DISABLE_ESLINT": "1",
    "NEXT_TELEMETRY_DISABLED": "1"
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" }
      ]
    }
  ]
}
