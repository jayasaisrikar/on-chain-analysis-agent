# Environment Variables for Vercel Deployment
# Copy this file to .env.local for local development
# Set these in your Vercel dashboard for production

# ADK Framework Configuration
ADK_DEBUG="false" # enable this for framework logs

# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Google/Gemini API Configuration  
GOOGLE_API_KEY=your_google_api_key_here # get it from https://aistudio.google.com/apikey

# Web Search Configuration (Optional)
TAVILY_API_KEY= # get it from https://tavily.com (optional for web search)

# CoinGecko API Configuration
COINGECKO_API_KEY= # <your key here>

# LLM Model Configuration
LLM_MODEL="gemini-2.5-flash" #for cost efficiency, you can also use "gemini-1.5-flash"

# Next.js Configuration
NEXT_TELEMETRY_DISABLED=1

# Optional: Set this to enable debug logging
# DEBUG_MODE=true